# -----------------------------------------------------------------------------
# Medivra Backend Local Environment Variables Template
# Copy this file to '.env.local' and fill in your actual credentials.
# '.env.local' is gitignored and will NOT be pushed to GitHub.
# -----------------------------------------------------------------------------

# --- Razorpay Credentials ---
# Enable Razorpay (set to false to run in mock payment mode)
export RAZORPAY_ENABLED=true
export RAZORPAY_KEY_ID=your_razorpay_key_id_here
export RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# --- Email Credentials (Optional if defined in ~/.zshrc or system environment) ---
# If you run the app using 'start.sh', you can also define these here.
# export SPRING_MAIL_USERNAME=your_gmail@gmail.com
# export SPRING_MAIL_PASSWORD=your_gmail_app_password
